# Postgres (used by the postgres container and to build DATABASE_URL below)
POSTGRES_USER=nightguard
POSTGRES_PASSWORD=changeme
POSTGRES_DB=nightguard

# Backend
DATABASE_URL=postgresql://nightguard:changeme@postgres:5432/nightguard
SECRET_KEY=changeme-dev-secret-key
ENVIRONMENT=development
LOG_LEVEL=INFO

# Auth / JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Azure OpenAI (LLM provider — see app/llm/ for the provider-agnostic interface).
# AZURE_OPENAI_DEPLOYMENT is the chat/completion model deployment name (used from
# Phase 7+). AZURE_OPENAI_EMBEDDING_DEPLOYMENT is the embedding model deployment
# name (used by Phase 6 chunking/retrieval). Fill these in your own local .env —
# never commit real values here.
AZURE_OPENAI_API_KEY=changeme
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=changeme-chat-deployment-name
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=changeme-embedding-deployment-name
# Optional override — defaults to 2024-05-01-preview, the version confirmed working
# against an Azure AI Foundry (*.services.ai.azure.com) resource's unified
# /models/... inference API. A classic *.openai.azure.com resource may need a
# different value.
# AZURE_OPENAI_API_VERSION=2024-05-01-preview

# Gmail SMTP (real email notifications — see app/services/notifications/ for the
# provider-agnostic interface; SMS is a stubbed provider only for now). Use a
# Gmail Account App Password (myaccount.google.com/apppasswords — requires
# 2-Step Verification on the account), NOT your normal Gmail login password.
# Fill these in your own local .env — never commit real values here.
GMAIL_ADDRESS=changeme@gmail.com
GMAIL_APP_PASSWORD=changeme-16-char-app-password

# Twilio SMS (real premium-tier SMS — see app/services/notifications/sms_provider.py).
# Optional: a business's sms_enabled flag alone does NOT send real texts — these
# three must ALSO all be set, or every SMS falls back to the safe simulated stub
# (logged, never a real send). Get a free trial account at twilio.com/try-twilio;
# TWILIO_FROM_NUMBER is the Twilio number you send from (E.164, e.g. +15551234567).
# Fill these in your own local .env — never commit real values here.
TWILIO_ACCOUNT_SID=changeme-twilio-account-sid
TWILIO_AUTH_TOKEN=changeme-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567

# WhatsApp Cloud API (real webhook handling — see app/services/channels/whatsapp.py
# and app/api/routes/webhooks.py). No production Meta Business account exists yet
# (Phase 22) — WHATSAPP_ACCESS_TOKEN absent means outgoing sends safely simulate
# instead of crashing. WHATSAPP_APP_SECRET/WHATSAPP_VERIFY_TOKEN are still real and
# enforced even without a live Meta account: generate any random local value for
# dev/testing (e.g. `openssl rand -hex 32`) — they just need to match what you'd
# register in the Meta App Dashboard once a real app exists.
# WHATSAPP_APP_SECRET: verifies the X-Hub-Signature-256 HMAC on every inbound
#   webhook — Meta issues this per-app once you create a real Meta App.
# WHATSAPP_VERIFY_TOKEN: an arbitrary string YOU choose, compared against Meta's
#   hub.verify_token during the one-time webhook subscription handshake.
# WHATSAPP_ACCESS_TOKEN: the real Send API bearer token (system user or
#   temporary token from the Meta App Dashboard). Leave blank until a real
#   account exists — every send safely falls back to a logged simulation.
# Fill these in your own local .env — never commit real values here.
WHATSAPP_APP_SECRET=changeme-whatsapp-app-secret
WHATSAPP_VERIFY_TOKEN=changeme-whatsapp-verify-token
WHATSAPP_ACCESS_TOKEN=

# Messenger Platform (real webhook handling — see app/services/channels/messenger.py
# and app/api/routes/webhooks.py). No production Meta Page exists yet (Phase 26) —
# same honest gap as WhatsApp above. MESSENGER_APP_SECRET/MESSENGER_VERIFY_TOKEN
# play the identical role as their WhatsApp counterparts (generate any random
# local value for dev/testing, e.g. `openssl rand -hex 32`).
# There is no MESSENGER_ACCESS_TOKEN here: unlike WhatsApp's one platform-wide
# token, Messenger's Send API needs a per-Page access token — that's stored per
# business in its own Integration row (config.page_access_token), not here.
# Fill these in your own local .env — never commit real values here.
MESSENGER_APP_SECRET=changeme-messenger-app-secret
MESSENGER_VERIFY_TOKEN=changeme-messenger-verify-token

# Instagram Messaging (real webhook handling — see app/services/channels/instagram.py
# and app/api/routes/webhooks.py). No production Meta Instagram professional account
# exists yet (Phase 27) — same honest gap as WhatsApp/Messenger above.
# INSTAGRAM_APP_SECRET/INSTAGRAM_VERIFY_TOKEN play the identical role as their
# WhatsApp/Messenger counterparts (generate any random local value for dev/testing,
# e.g. `openssl rand -hex 32`).
# There is no INSTAGRAM_ACCESS_TOKEN here: like Messenger, Instagram's Send API needs
# a per-account access token — that's stored per business in its own Integration row
# (config.access_token), not here.
# Fill these in your own local .env — never commit real values here.
INSTAGRAM_APP_SECRET=changeme-instagram-app-secret
INSTAGRAM_VERIFY_TOKEN=changeme-instagram-verify-token

# Google Calendar OAuth (real Premium-tier calendar sync — see
# app/services/google_calendar_service.py, Phase 40). Get GOOGLE_CLIENT_ID/
# GOOGLE_CLIENT_SECRET from a "Web application" OAuth 2.0 Client ID in Google
# Cloud Console (APIs & Services > Credentials), for a project with the Google
# Calendar API enabled and an OAuth consent screen configured with the
# https://www.googleapis.com/auth/calendar scope. GOOGLE_REDIRECT_URI must be
# registered VERBATIM (exact string match) as an Authorized redirect URI on
# that same OAuth client, and must equal wherever
# app/api/routes/google_calendar.py's callback route is actually reachable —
# see PHASE_STATUS.md Phase 40 for the exact setup steps and known limitations
# (e.g. test-mode refresh tokens expiring after 7 days).
# Fill these in your own local .env — never commit real values here.
GOOGLE_CLIENT_ID=changeme-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=changeme-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8010/api/v1/integrations/google-calendar/callback

# Where the OAuth callback redirects the user's browser back to after a real
# Google consent flow completes (the dashboard SPA's own origin, not this API).
DASHBOARD_BASE_URL=http://localhost:5173

# --- Future: LLM provider selection (V2+, not yet implemented) ---
# USING_LLM selects which chat provider Phase 6's ChatProvider abstraction should use.
# Not yet read by any code — placeholder for a future provider-selection phase.
USING_LLM=azure
# Anthropic API key — not yet read by any code, placeholder for a future provider.
ANTHROPIC_API_KEY=
# OpenAI API key — not yet read by any code, placeholder for a future provider.
OPENAI_API_KEY=
# DeepSeek API key — not yet read by any code, placeholder for a future provider.
DEEPSEEK_API_KEY=
# Qwen API key — not yet read by any code, placeholder for a future provider.
QWEN_API_KEY=
# xAI (Grok) API key — not yet read by any code, placeholder for a future provider.
XAI_API_KEY=

# Deepgram (real-time speech-to-text + text-to-speech for in-app voice chat —
# see app/voice/deepgram.py, Phase 43). One key covers both Nova (STT) and
# Aura (TTS). Get one at console.deepgram.com. Leave blank to develop without
# voice — every other feature (text chat, booking, etc.) is unaffected; a
# voice call attempted with no key configured degrades to a clear in-call
# error message rather than crashing.
# Fill this in your own local .env — never commit a real value here.
DEEPGRAM_API_KEY=

# --- Future: Voice TTS fallback provider (V2, not yet implemented) ---
# ElevenLabs API key — not yet read by any code, placeholder for a future
# TTS provider swap (see app/voice/'s provider seam) if ever needed.
ELEVENLABS_API_KEY=
