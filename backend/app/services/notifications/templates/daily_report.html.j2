{% extends "base.html.j2" %}
{% block content %}
<h1 style="margin:0 0 4px 0;font-size:20px;line-height:26px;color:#1f2937;font-family:Arial,Helvetica,sans-serif;">Daily Report</h1>
<p style="margin:0 0 24px 0;font-size:14px;line-height:20px;color:#4b5563;font-family:Arial,Helvetica,sans-serif;">{{ period_label }} &middot; full detail is in the attached Excel file.</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;border:1px solid #e5e7eb;border-radius:6px;overflow:hidden;">
<tr>
<td style="background-color:#1f3a5f;color:#ffffff;font-size:12px;font-weight:bold;padding:10px 16px;font-family:Arial,Helvetica,sans-serif;">Metric</td>
<td style="background-color:#1f3a5f;color:#ffffff;font-size:12px;font-weight:bold;padding:10px 16px;text-align:right;font-family:Arial,Helvetica,sans-serif;">Count</td>
</tr>
{% for label, value in rows %}
<tr>
<td style="padding:10px 16px;font-size:14px;color:#111827;border-top:1px solid #e5e7eb;font-family:Arial,Helvetica,sans-serif;{% if loop.last %}font-weight:bold;{% endif %}">{{ label }}</td>
<td style="padding:10px 16px;font-size:14px;color:#111827;border-top:1px solid #e5e7eb;text-align:right;font-family:Arial,Helvetica,sans-serif;{% if loop.last %}font-weight:bold;{% endif %}">{{ value }}</td>
</tr>
{% endfor %}
</table>
{% endblock %}
