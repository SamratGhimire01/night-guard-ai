{% extends "base.html.j2" %}
{% block content %}
<h1 style="margin:0 0 16px 0;font-size:20px;line-height:26px;color:#1f2937;font-family:Arial,Helvetica,sans-serif;">{{ headline }}</h1>
<p style="margin:0 0 24px 0;font-size:14px;line-height:20px;color:#4b5563;font-family:Arial,Helvetica,sans-serif;">
{% if customer_name %}Hi {{ customer_name }},{% else %}Hi,{% endif %}
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f9fafb;border:1px solid #e5e7eb;border-radius:6px;">
<tr>
<td style="padding:20px 24px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
<tr>
<td style="padding:6px 0;font-size:13px;color:#6b7280;font-family:Arial,Helvetica,sans-serif;width:110px;vertical-align:top;">Service</td>
<td style="padding:6px 0;font-size:14px;color:#111827;font-weight:bold;font-family:Arial,Helvetica,sans-serif;">{{ service_name }}</td>
</tr>
<tr>
<td style="padding:6px 0;font-size:13px;color:#6b7280;font-family:Arial,Helvetica,sans-serif;vertical-align:top;">When</td>
<td style="padding:6px 0;font-size:14px;color:#111827;font-family:Arial,Helvetica,sans-serif;">{{ when }}</td>
</tr>
<tr>
<td style="padding:6px 0;font-size:13px;color:#6b7280;font-family:Arial,Helvetica,sans-serif;vertical-align:top;">Status</td>
<td style="padding:6px 0;">
<span style="display:inline-block;padding:3px 12px;border-radius:12px;font-size:12px;font-weight:bold;background-color:{{ status_bg }};color:{{ status_color }};font-family:Arial,Helvetica,sans-serif;">{{ status_label }}</span>
</td>
</tr>
<tr>
<td style="padding:6px 0;font-size:13px;color:#6b7280;font-family:Arial,Helvetica,sans-serif;vertical-align:top;">Booking ID</td>
<td style="padding:6px 0;font-size:12px;color:#6b7280;font-family:'Courier New',Courier,monospace;">{{ booking_id }}</td>
</tr>
</table>
</td>
</tr>
</table>

<p style="margin:24px 0 0 0;font-size:13px;line-height:20px;color:#8a8f98;font-family:Arial,Helvetica,sans-serif;">If anything here looks wrong, just reach out to us directly and we'll sort it out.</p>
{% endblock %}
