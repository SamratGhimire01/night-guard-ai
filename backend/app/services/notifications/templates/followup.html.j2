{% extends "base.html.j2" %}
{% block content %}
<h1 style="margin:0 0 16px 0;font-size:20px;line-height:26px;color:#1f2937;font-family:Arial,Helvetica,sans-serif;">Still thinking it over?</h1>
<p style="margin:0 0 20px 0;font-size:14px;line-height:20px;color:#4b5563;font-family:Arial,Helvetica,sans-serif;">
{% if customer_name %}Hi {{ customer_name }},{% else %}Hi,{% endif %} we wanted to follow up on your recent question.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f9fafb;border:1px solid #e5e7eb;border-radius:6px;">
<tr>
<td style="padding:16px 20px;">
<p style="margin:0 0 4px 0;font-size:12px;color:#6b7280;font-family:Arial,Helvetica,sans-serif;">You asked us:</p>
<p style="margin:0;font-size:14px;line-height:20px;color:#111827;font-style:italic;font-family:Arial,Helvetica,sans-serif;">&ldquo;{{ quoted_message }}&rdquo;</p>
</td>
</tr>
</table>

<p style="margin:20px 0 0 0;font-size:14px;line-height:20px;color:#4b5563;font-family:Arial,Helvetica,sans-serif;">If you'd still like to book, or have any other questions, just reply to this email or reach out to {{ business_name }} directly — we're happy to help.</p>
{% endblock %}
